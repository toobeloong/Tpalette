{
  "name": "Desert Sand",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#2B2018",
    "editor.foreground": "#D4C4A8",
    "editorLineNumber.foreground": "#7A6A50",
    "editorLineNumber.activeForeground": "#E8A87C",
    "editor.selectionBackground": "#4A3828",
    "editor.selectionHighlightBackground": "#4A382880",
    "editor.findMatchBackground": "#E8A87C80",
    "editor.findMatchHighlightBackground": "#E8A87C40",
    "editorCursor.foreground": "#EDE0C8",
    "editor.lineHighlightBackground": "#33261C",
    "editorIndentGuide.background": "#3D3020",
    "editorIndentGuide.activeBackground": "#7A6A50",
    "editorBracketMatch.border": "#E8A87C80",
    "editorGutter.background": "#2B2018",
    "editorWidget.background": "#221A14",
    "editorWidget.border": "#3D3020",
    "editorSuggestWidget.background": "#221A14",
    "editorSuggestWidget.border": "#3D3020",
    "editorSuggestWidget.selectedBackground": "#4A3828",
    "editorHoverWidget.background": "#221A14",
    "editorHoverWidget.border": "#3D3020",
    "editorGroup.border": "#3D3020",
    "editorGroupHeader.tabsBackground": "#221A14",
    "tab.activeBackground": "#2B2018",
    "tab.activeForeground": "#EDE0C8",
    "tab.inactiveBackground": "#221A14",
    "tab.inactiveForeground": "#7A6A50",
    "tab.border": "#3D3020",
    "tab.activeBorderTop": "#E8A87C",
    "sideBar.background": "#221A14",
    "sideBar.foreground": "#D4C4A8",
    "sideBar.border": "#3D3020",
    "sideBarTitle.foreground": "#EDE0C8",
    "sideBarSectionHeader.background": "#2B2018",
    "list.activeSelectionBackground": "#4A3828",
    "list.activeSelectionForeground": "#EDE0C8",
    "list.inactiveSelectionBackground": "#4A382880",
    "list.hoverBackground": "#33261C",
    "list.foreground": "#D4C4A8",
    "activityBar.background": "#221A14",
    "activityBar.foreground": "#D4C4A8",
    "activityBar.activeBorder": "#E8A87C",
    "activityBarBadge.background": "#E8A87C",
    "activityBarBadge.foreground": "#221A14",
    "statusBar.background": "#221A14",
    "statusBar.foreground": "#D4C4A8",
    "statusBar.debuggingBackground": "#D4644A",
    "titleBar.activeBackground": "#221A14",
    "titleBar.activeForeground": "#D4C4A8",
    "menu.background": "#221A14",
    "menu.foreground": "#D4C4A8",
    "menu.selectionBackground": "#4A3828",
    "menu.separatorBackground": "#3D3020",
    "button.background": "#E8A87C",
    "button.foreground": "#221A14",
    "button.hoverBackground": "#C38D5E",
    "input.background": "#221A14",
    "input.border": "#3D3020",
    "input.foreground": "#EDE0C8",
    "input.placeholderForeground": "#7A6A50",
    "dropdown.background": "#221A14",
    "dropdown.border": "#3D3020",
    "dropdown.foreground": "#D4C4A8",
    "scrollbarSlider.background": "#7A6A5040",
    "scrollbarSlider.hoverBackground": "#7A6A5060",
    "scrollbarSlider.activeBackground": "#7A6A5080",
    "panel.background": "#221A14",
    "panel.border": "#3D3020",
    "panelTitle.activeBorder": "#E8A87C",
    "panelTitle.activeForeground": "#EDE0C8",
    "panelTitle.inactiveForeground": "#7A6A50",
    "terminal.background": "#2B2018",
    "terminal.foreground": "#D4C4A8",
    "terminal.border": "#3D3020",
    "gitDecoration.addedResourceForeground": "#A8C090",
    "gitDecoration.modifiedResourceForeground": "#F0C896",
    "gitDecoration.deletedResourceForeground": "#D4644A",
    "gitDecoration.untrackedResourceForeground": "#A8C090",
    "gitDecoration.ignoredResourceForeground": "#7A6A50",
    "gitDecoration.conflictResourceForeground": "#F0C896",
    "badge.background": "#E8A87C",
    "badge.foreground": "#221A14",
    "progressBar.background": "#E8A87C",
    "focusBorder": "#E8A87C80",
    "foreground": "#D4C4A8",
    "descriptionForeground": "#7A6A50",
    "errorForeground": "#D4644A",
    "icon.foreground": "#7A6A50",
    "selection.background": "#4A3828",
    "textLink.foreground": "#E8A87C",
    "textLink.activeForeground": "#C38D5E",
    "widget.shadow": "#00000060"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A5A40",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Boolean / Null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#C38D5E"
      }
    },
    {
      "name": "Storage / Modifier",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C38D5E"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Class / Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#D4A574"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#D4C4A8"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#F0C896"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#C0A880"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#C38D5E"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7A6A50"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#C38D5E"
      }
    },
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D4A574"
      }
    },
    {
      "name": "Namespace / Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#D4A574"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.enum",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "JSON Key",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C0A880"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#C0A880"
      }
    },
    {
      "name": "CSS Value",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "HTML Tag Name",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xhtml"
      ],
      "settings": {
        "foreground": "#C38D5E"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#D4A574",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D4C4A8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F0C896",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.raw.code",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "URL",
      "scope": [
        "markup.underline.link.http",
        "markup.underline.link.https"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Invalid / Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D4644A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#A8C090"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#D4644A"
      }
    },
    {
      "name": "Diff Modified",
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#F0C896"
      }
    }
  ]
}